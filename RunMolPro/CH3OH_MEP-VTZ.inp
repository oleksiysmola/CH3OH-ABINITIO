***, Methanol Ground State Energy with CCSD(T)-F12 and cc-pVQZ-F12
memory,500,m;

symmetry,nosym
geometry={angstrom
c 
o , 1, rco 
h , 2, roh, 1, acoh
h1, 1, rch1, 2, aoch1  3  ahh1
h2, 1, rch2, 2, aoch2, 3, ahh2
h3, 1, rch3, 2, aoch3, 3, ahh3
}


rco= 1.41997934
roh= 0.95818958
rch1= 1.09312547
rch2= 1.08754749
rch3= 1.09312547
acoh= 108.21042647
aoch1= 111.89503696
aoch2= 106.72939010
aoch3= 111.89503696
ahh1=61.38282783
ahh2=180.00
ahh3=298.61717217


! Use the aug-cc-pVTZ-F12 basis set
basis=aug-cc-pVTZ

hf
optg,procedure=runccsd,savexyz=CH3OH_equilibrium_mp2.xyz
method=qsd,numhess=1,hesscentral,saveact=CH3OH_FollowMEP
runccsd = {hf;ccsd(t)}


--- End of Script ---