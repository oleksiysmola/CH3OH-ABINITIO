***, Methanol Ground State Energy with CCSD and cc-pVQZ
memory,500,m;

geometry={angstrom
c 
o , 1, rco 
h , 2, roh, 1, acoh
h1, 1, rch1, 2, aoch1  3  ahh1
h2, 1, rch2, 2, aoch2, 3, ahh2
h3, 1, rch3, 2, aoch3, 3, ahh3
}


rco= 1.4296
roh= 0.95887
rch1= 1.092294
rch2= 1.092294
rch3= 1.092294
acoh= 107.9812
aoch1= 110.6646
aoch2= 110.6646
aoch3= 110.6646
ahh1=0.00
ahh2=120.00
ahh3=240.00

! Use the aug-cc-pVTZ basis set
basis=aug-cc-pVTZ

hf
{optg,procedure=runccsd,savexyz=CH3OH_maxima_mp2.xyz
active,rco,roh,rch1,rch2,rch3,acoh,aoch1,aoch2,aoch3,ahh2,ahh3;}
runccsd = {hf;ccsd}


--- End of Script ---