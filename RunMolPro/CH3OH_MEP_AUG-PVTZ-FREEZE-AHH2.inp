***, Methanol Ground State Energy with CCSD(T) and aug-cc-pVTZ
memory,500,m;

symmetry,nosym
geometry={angstrom
c 
o , 1, rco 
h , 2, roh, 1, acoh
h1, 1, rch1, 2, aoch1  3  ahh1
h2, 1, rch2, 2, aoch2, 3, ahh2
h3, 1, rch3, 2, aoch3, 3, ahh3
}

rco= 1.41997934
roh= 0.95818958
rch1= 1.09312547
rch2= 1.08754749
rch3= 1.09312547
acoh= 108.21042647
aoch1= 111.89503696
aoch2= 106.72939010
aoch3= 111.89503696
ahh1=61.38282783
ahh2=180.00
ahh3=298.61717217


Sa = -1.6936112928100562
Sb = 2.9334208074194277
tau = 60
ahh1 = tau+1.0/3.0*sqrt(2.0)*Sb                             
ahh2 = 120.0+tau-1.0/6.0*sqrt(2.0)*Sb-1.0/6.0*sqrt(6.0)*Sa  
ahh3 = 240.0+tau+1.0/6.0*sqrt(6.0)*Sa-1.0/6.0*sqrt(2.0)*Sb  


basis=aug-cc-pVTZ

hf
runccsd = {hf;ccsd}


do i = 185, 300, 5
    ahh2 = i
    
    geometry={angstrom
    c 
    o , 1, rco 
    h , 2, roh, 1, acoh
    h1, 1, rch1, 2, aoch1  3  ahh1
    h2, 1, rch2, 2, aoch2, 3, ahh2
    h3, 1, rch3, 2, aoch3, 3, ahh3
    }

    {OPTG,procedure=runccsd,savexyz=CH3OH_maxima_mp2.xyz
    active,rco,roh,rch1,rch2,rch3,acoh,aoch1,aoch2,aoch3,ahh1,ahh3;
    END}

enddo

--- End of Script ---