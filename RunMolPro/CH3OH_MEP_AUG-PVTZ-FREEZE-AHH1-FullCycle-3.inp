***,Methanol Ground State Energy with CCSD and aug-cc-pVTZ
 memory,500,m;
 
 geometry={angstrom
 c
 o , 1, rco
 h , 2, roh, 1, acoh
 h1, 1, rch1, 2, aoch1  3  ahh1
 h2, 1, rch2, 2, aoch2, 3, ahh2
 h3, 1, rch3, 2, aoch3, 3, ahh3
 }
 
rco=     1.50000000
roh=     1.00000000
rch1=    1.50000000
rch2=    1.50000000
rch3=    1.50000000
acoh=  110.00000000
aoch1= 115.00000000
aoch2= 115.00000000
aoch3= 115.00000000
ahh1= -120.00000000
ahh2=    0.00000000
ahh3=  120.00000000
 
 
basis=aug-cc-pVTZ
 
hf
ccsd
runccsd = {hf;ccsd}

{OPTG,procedure=runccsd,savexyz=CH3OH_maxima_mp2.xyz
active,rco,roh,rch1,rch2,rch3,acoh,aoch1,aoch2,aoch3,ahh2,ahh3;
END}

xxx = "mmm"
tau = (ahh1 + ahh2 + ahh3)/3
table,xxx,rco,roh,rch1,rch2,rch3,acoh,aoch1,aoch2,aoch3,ahh1,ahh2,ahh3,tau
DIGITS, 0, 8, 8, 8, 8, 8, 8, 8, 8, 8,  8,  8,  8, 8
 
 
 do i = -117.5, 240, 2.5
     rco=     1.50000000
     roh=     1.00000000
     rch1=    1.50000000
     rch2=    1.50000001
     rch3=    1.50000002
     acoh=  110.00000000
     aoch1= 115.00000000
     aoch2= 115.00000001
     aoch3= 115.00000002
     ahh1 = i
     ahh2 = i + 120
     ahh3 = i + 240
 
     geometry={angstrom
     c
     o , 1, rco
     h , 2, roh, 1, acoh
     h1, 1, rch1, 2, aoch1  3  ahh1
     h2, 1, rch2, 2, aoch2, 3, ahh2
     h3, 1, rch3, 2, aoch3, 3, ahh3
     }
 
     {OPTG,procedure=runccsd,savexyz=CH3OH_maxima_mp2.xyz
     active,rco,roh,rch1,rch2,rch3,acoh,aoch1,aoch2,aoch3,ahh2,ahh3;
     END}
 
     xxx = "mmm"
     tau = (ahh1 + ahh2 + ahh3)/3
     table,xxx,rco,roh,rch1,rch2,rch3,acoh,aoch1,aoch2,aoch3,ahh1,ahh2,ahh3,tau
     DIGITS, 0, 8, 8, 8, 8, 8, 8, 8, 8, 8,  8,  8,  8, 8
 
 enddo